{
  "$schema": "./@types/schema/package/index.json",
  "package_version": 2,
  "version": "1.0.0",
  "name": "tripo3d_cocos_bridge",
  "title": "Tripo Bridge",
  "icon": "./static/images/icon128.png",
  "description": "i18n:tripo3d_cocos_bridge.description",
  "author": "Tripo3D",
  "editor": ">=3.8.5",
  "main": "./dist/main.js",
  "scripts": {
    "preinstall": "node ./scripts/preinstall.js",
    "build": "npx tsc",
    "watch": "npx tsc -w"
  },
  "dependencies": {
    "unzipper": "^0.12.3",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@cocos/creator-types": "^3.8.7",
    "@types/node": "^18.19.86",
    "@types/unzipper": "^0.10.11",
    "@types/ws": "^8.18.1",
    "typescript": "^5.8.2"
  },
  "panels": {
    "default": {
      "title": "i18n:tripo3d_cocos_bridge.panel_title",
      "type": "dockable",
      "main": "dist/panels/default",
      "size": {
        "min-width": 320,
        "min-height": 420,
        "width": 360,
        "height": 560
      }
    }
  },
  "contributions": {
    "menu": [
      {
        "path": "i18n:menu.panel",
        "label": "i18n:tripo3d_cocos_bridge.panel_title",
        "message": "open-panel"
      }
    ],
    "messages": {
      "open-panel": {
        "methods": [
          "openPanel"
        ]
      },
      "query-state": {
        "methods": [
          "queryState"
        ]
      },
      "start-server": {
        "methods": [
          "startServer"
        ]
      },
      "stop-server": {
        "methods": [
          "stopServer"
        ]
      },
      "clear-logs": {
        "methods": [
          "clearLogs"
        ]
      },
      "state-changed": {
        "methods": [
          "default.onStateChanged"
        ]
      }
    }
  }
}
